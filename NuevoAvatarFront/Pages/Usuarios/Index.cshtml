@page
@model NuevoAvatarFront.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Administración de Usuarios";
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 text-gray-800">Usuarios del Sistema</h1>

    <a href="/Usuarios/Upsert" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nuevo Usuario
    </a>
</div>

<!-- ALERTAS -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (TempData["ErrorMessage"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger">@err</div>
}

@if (TempData["SuccessMessage"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}

<!-- CARD DE FILTROS -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Filtros</h6>
    </div>

    <div class="card-body">
        <form id="filtroForm" class="row g-3">

            <div class="col-md-3">
                <label class="form-label fw-bold">Identificación</label>
                <input type="text" id="filtroIdentificacion"
                       class="form-control shadow-sm" placeholder="Buscar...">
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Nombre</label>
                <input type="text" id="filtroNombre"
                       class="form-control shadow-sm" placeholder="Buscar...">
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Rol</label>
                <select id="filtroRol" class="form-select shadow-sm">
                    <option value=""></option>
                    <option value="Estudiante">Estudiante</option>
                    <option value="Profesor">Profesor</option>
                    <option value="Administrador">Administrador</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Dominio</label>
                <select id="filtroDominio" class="form-select shadow-sm">
                    <option value=""></option>
                    <option value="cuc.cr">cuc.cr</option>
                    <option value="cuc.ac.cr">cuc.ac.cr</option>
                </select>
            </div>

        </form>
    </div>
</div>

<!-- TABLA -->
<div class="card shadow">
    <div class="card-body">

        <table id="usuariosTable" class="table table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Email</th>
                    <th>Tipo Identificación</th>
                    <th>Identificación</th>
                    <th>Nombre</th>
                    <th>Rol</th>
                    <th style="width:150px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr class="usuario-row"
                        data-dominio="@usuario.Email.Split('@')[1]">

                        <td>@usuario.Email</td>
                        <td>@usuario.Tipo_Identificacion</td>
                        <td>@usuario.Identificacion</td>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.RolNombre</td>

                        <td>
                            <a href="/Usuarios/Upsert?id=@usuario.ID_Usuario"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-id="@usuario.ID_Usuario"
                                  class="d-inline delete-form">

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        onclick="confirmDelete(event)">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<!-- PAGINACIÓN -->
<div class="d-flex justify-content-center mt-4">
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="?page=@(Model.Pagina - 1)&filtro=@Model.Filtro&rol=@Model.Rol">
                    Anterior
                </a>
            </li>

            <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   href="?page=@(Model.Pagina + 1)&filtro=@Model.Filtro&rol=@Model.Rol">
                    Siguiente
                </a>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function filterTable() {
            const filtroIdentificacion = document.getElementById('filtroIdentificacion').value.toLowerCase();
            const filtroNombre = document.getElementById('filtroNombre').value.toLowerCase();
            const filtroRol = document.getElementById('filtroRol').value.toLowerCase();
            const filtroDominio = document.getElementById('filtroDominio').value.toLowerCase();

            const rows = document.querySelectorAll('#usuariosTable tbody tr.usuario-row');

            rows.forEach(row => {
                const identificacion = row.children[2].textContent.toLowerCase();
                const nombre = row.children[3].textContent.toLowerCase();
                const rol = row.children[4].textContent.toLowerCase();
                const dominio = row.getAttribute('data-dominio').toLowerCase();

                const visible =
                    identificacion.includes(filtroIdentificacion) &&
                    nombre.includes(filtroNombre) &&
                    (filtroRol === "" || rol.includes(filtroRol)) &&
                    (filtroDominio === "" || dominio.includes(filtroDominio));

                row.style.display = visible ? "" : "none";
            });
        }

        document.getElementById('filtroIdentificacion').addEventListener('input', filterTable);
        document.getElementById('filtroNombre').addEventListener('input', filterTable);
        document.getElementById('filtroRol').addEventListener('change', filterTable);
        document.getElementById('filtroDominio').addEventListener('change', filterTable);

        // SWEETALERT DELETE
        function confirmDelete(e) {
            e.preventDefault();

            Swal.fire({
                title: '¿Eliminar usuario?',
                text: 'Esta acción no se puede revertir.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(r => {
                if (r.isConfirmed) {
                    let form = e.target.closest("form");
                    form.submit();
                }
            });
        }

        window.onload = filterTable;
    </script>
}
