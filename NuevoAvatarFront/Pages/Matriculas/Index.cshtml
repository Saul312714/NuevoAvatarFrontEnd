@page
@model NuevoAvatarFront.Pages.Matriculas.IndexModel
@{
    ViewData["Title"] = "Gestión de Matrículas";
}

<div class="container-fluid">

    <!-- HEADER TIPO GRUPOS -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-gray-800">
            <i class="bi bi-clipboard-check"></i> Gestión de Matrículas
        </h1>
        @* Aquí podrías poner un botón extra si quisieras, lo dejo vacío para no inventar flujo nuevo *@
        <div></div>
    </div>

    @* Mensajes *@
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle"></i> @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ============================
         BLOQUE 1: NUEVA MATRÍCULA
         ============================ -->
    <div class="card shadow mb-4">
        <div class="card-header">
            <h5 class="mb-0 text-gray-800">
                <i class="bi bi-magic"></i> Nueva Matrícula (flujo guiado)
            </h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Matricular">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <!-- Estudiante -->
                    <div class="col-md-4">
                        <label asp-for="NuevaMatricula.ID_Estudiante" class="form-label fw-bold text-gray-800">
                            1. Estudiante *
                        </label>
                        <select asp-for="NuevaMatricula.ID_Estudiante"
                                class="form-control shadow-sm"
                                asp-items="Model.Estudiantes">
                            <option value="">-- Seleccione un estudiante --</option>
                        </select>
                        <span asp-validation-for="NuevaMatricula.ID_Estudiante" class="text-danger"></span>
                    </div>

                    <!-- Curso -->
                    <div class="col-md-4">
                        <label asp-for="NuevaMatricula.ID_Curso" class="form-label fw-bold text-gray-800">
                            2. Curso *
                        </label>
                        <select asp-for="NuevaMatricula.ID_Curso"
                                class="form-control shadow-sm"
                                asp-items="Model.Cursos">
                            <option value="">-- Seleccione un curso --</option>
                        </select>
                        <span asp-validation-for="NuevaMatricula.ID_Curso" class="text-danger"></span>
                    </div>

                    <!-- Periodo -->
                    <div class="col-md-4">
                        <label asp-for="NuevaMatricula.ID_Periodo" class="form-label fw-bold text-gray-800">
                            3. Período (activo) *
                        </label>
                        <select asp-for="NuevaMatricula.ID_Periodo"
                                class="form-control shadow-sm"
                                asp-items="Model.PeriodosActivos">
                            <option value="">-- Seleccione un periodo --</option>
                        </select>
                        <span asp-validation-for="NuevaMatricula.ID_Periodo" class="text-danger"></span>
                        <div class="form-text">
                            La API valida que el período esté ACTIVO.
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <!-- Grupo (combo) -->
                    <div class="col-md-4">
                        <label asp-for="NuevaMatricula.ID_Grupo" class="form-label fw-bold text-gray-800">
                            4. Grupo *
                        </label>

                        <!-- NUEVO: combo de grupos -->
                        <select asp-for="NuevaMatricula.ID_Grupo"
                                class="form-control shadow-sm"
                                asp-items="Model.Grupos">
                            <option value="">-- Seleccione un grupo --</option>
                        </select>
                        <span asp-validation-for="NuevaMatricula.ID_Grupo" class="text-danger"></span>
                        <div class="form-text">
                            Seleccione el grupo (curso, número de grupo y horario provienen de la API de grupos).
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success shadow">
                        <i class="bi bi-save"></i> Confirmar Matrícula
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================
         BLOQUE 2: LISTADO / CSV
         ============================ -->
    <div class="card shadow">
        <div class="card-header">
            <h5 class="mb-0 d-flex justify-content-between align-items-center text-gray-800">
                <span>
                    <i class="bi bi-table"></i> Estudiantes Matriculados por Curso / Grupo
                </span>

                @if (Model.FiltroCurso.HasValue && Model.FiltroGrupo.HasValue && Model.Matriculados.Any())
                {
                    <span class="badge bg-secondary">
                        @Model.Matriculados.Count matriculados
                    </span>
                }
            </h5>
        </div>
        <div class="card-body">
            <!-- Filtros (estilo similar a Grupos) -->
            <form method="get" asp-page="./Index" class="row g-3 mb-4 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-gray-800">Curso</label>
                    <select asp-for="FiltroCurso" class="form-control shadow-sm" asp-items="Model.Cursos">
                        <option value="">-- Seleccione curso --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-gray-800">Grupo</label>

                    <!-- combo de grupos para el filtro -->
                    <select asp-for="FiltroGrupo" class="form-control shadow-sm" asp-items="Model.Grupos">
                        <option value="">-- Seleccione grupo --</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary shadow me-2 flex-fill">
                        <i class="bi bi-search"></i> Buscar matriculados
                    </button>

                    <!-- BOTÓN PARA LLAMAR AL HANDLER OnGetExportCsvAsync -->
                    <button type="submit"
                            class="btn btn-outline-secondary shadow flex-fill"
                            formaction="/Matriculas/Index?handler=ExportCsv"
                            formmethod="get">
                        <i class="bi bi-download"></i> Exportar CSV
                    </button>
                </div>
            </form>

            <!-- Tabla -->
            @if (Model.Matriculados.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>ID Estudiante</th>
                                <th>Identificación</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>ID Curso</th>
                                <th>ID Grupo</th>
                                <th>ID Periodo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Matriculados)
                            {
                                <tr>
                                    <td>@m.ID_Estudiante</td>
                                    <td>@m.Identificacion</td>
                                    <td>@m.Nombre</td>
                                    <td>@m.Email</td>
                                    <td>@m.ID_Curso</td>
                                    <td>@m.ID_Grupo</td>
                                    <td>@m.ID_Periodo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (Model.FiltroCurso.HasValue || Model.FiltroGrupo.HasValue)
            {
                <div class="alert alert-info mb-0" role="alert">
                    <i class="bi bi-info-circle"></i>
                    No se encontraron estudiantes matriculados para los filtros seleccionados.
                </div>
            }
            else
            {
                <div class="alert alert-secondary mb-0" role="alert">
                    Usa los filtros de curso y grupo para ver las matrículas y exportarlas a CSV.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Auto-cerrar alertas después de 5 segundos
        setTimeout(function () {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}