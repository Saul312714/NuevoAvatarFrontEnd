@page
@model NuevoAvatarFront.Pages.Instituciones.CreateModel
@{
    ViewData["Title"] = "Nueva Institución";
}
<h2>Nueva Institución</h2>

<form method="post" class="card p-3 shadow-sm">
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Form.Nombre" class="form-control" />
        <span asp-validation-for="Form.Nombre" class="text-danger"></span>
    </div>
    <div class="text-end">
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-primary">Guardar</button>
    </div>
</form>
