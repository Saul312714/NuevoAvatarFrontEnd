@page
@model NuevoAvatarFront.Pages.Instituciones.IndexModel
@{
    ViewData["Title"] = "Instituciones";
    Layout = "_Layout";
}

<div class="card shadow mb-4">

    <!-- HEADER -->
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Instituciones</h6>

        <a asp-page="/Instituciones/Create" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Nueva
        </a>
    </div>

    <div class="card-body">

        <!-- FILTRO -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <input asp-for="q" class="form-control" placeholder="Buscar por nombre..." />
            </div>

            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </form>

        <!-- SIN RESULTADOS -->
        @if (Model.Instituciones.Count == 0)
        {
            <div class="alert alert-info text-center">
                No hay instituciones registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th style="width:150px">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var i in Model.Instituciones)
                        {
                            <tr>
                                <td>@i.ID_Institucion</td>
                                <td>@i.Nombre</td>
                                <td>

                                    <!-- EDITAR -->
                                    <a asp-page="/Instituciones/Edit"
                                       asp-route-id="@i.ID_Institucion"
                                       class="btn btn-info btn-sm">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>

                                    <!-- ELIMINAR -->
                                    <a asp-page="/Instituciones/Delete"
                                       asp-route-id="@i.ID_Institucion"
                                       class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
