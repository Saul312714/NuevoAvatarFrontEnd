@page
@model NuevoAvatarFront.Pages.Expedientes.UpsertModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Expediente" : "Nuevo Expediente";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            @(Model.EsEdicion ? "Editar Expediente" : "Nuevo Expediente")
        </h6>
    </div>

    <div class="card-body">

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">

            <!-- HIDDEN NECESARIO PARA EDITAR -->
            <input type="hidden" asp-for="Expediente.ID_Estudiante" />

            <!-- IDENTIFICACIÓN -->
            <div class="form-group mb-3">
                <label>Identificación</label>
                <input asp-for="Expediente.Identificacion" class="form-control" />
            </div>

            <!-- TIPO IDENTIFICACIÓN -->
            <div class="form-group mb-3">
                <label>Tipo de Identificación</label>
                <select asp-for="Expediente.Tipo_Identificacion" class="form-control">
                    <option value="">Seleccione</option>
                    <option>NACIONAL</option>
                    <option>DIMEX</option>
                    <option>PASAPORTE</option>
                </select>
            </div>

            <!-- NOMBRE -->
            <div class="form-group mb-3">
                <label>Nombre Completo</label>
                <input asp-for="Expediente.Nombre" class="form-control" />
            </div>

            <!-- EMAIL -->
            <div class="form-group mb-3">
                <label>Email</label>
                <input asp-for="Expediente.Email" type="email" class="form-control" />
            </div>

            <!-- TELEFONO -->
            <div class="form-group mb-3">
                <label>Teléfono</label>
                <input asp-for="Expediente.Telefono" class="form-control" />
            </div>

            <!-- FECHA NACIMIENTO -->
            <div class="form-group mb-3">
                <label>Fecha de Nacimiento</label>
                <input asp-for="Expediente.Fecha_Nacimiento" type="date" class="form-control" />
            </div>

            <hr />
            <h5 class="text-primary">Dirección</h5>

            <!-- PROVINCIA -->
            <div class="form-group mb-3">
                <label>Provincia</label>
                <select asp-for="ProvinciaSeleccionada" class="form-control" onchange="this.form.submit()">
                    <option value="">Seleccione provincia</option>
                    @foreach (var p in Model.Provincias)
                    {
                        <option value="@p" selected="@(Model.ProvinciaSeleccionada == p)">
                            @p
                        </option>
                    }
                </select>
            </div>

            <!-- CANTÓN -->
            <div class="form-group mb-3">
                <label>Cantón</label>
                <select asp-for="CantonSeleccionado" class="form-control" onchange="this.form.submit()">
                    <option value="">Seleccione cantón</option>
                    @foreach (var c in Model.Cantones)
                    {
                        <option value="@c" selected="@(Model.CantonSeleccionado == c)">
                            @c
                        </option>
                    }
                </select>
            </div>

            <!-- DISTRITO -->
            <div class="form-group mb-3">
                <label>Distrito</label>
                <select asp-for="DistritoSeleccionado" class="form-control">
                    <option value="">Seleccione distrito</option>
                    @foreach (var d in Model.Distritos)
                    {
                        <option value="@d" selected="@(Model.DistritoSeleccionado == d)">
                            @d
                        </option>
                    }
                </select>
            </div>

            <hr />

            <button type="submit" class="btn btn-success">
                <i class="fas fa-save"></i> Guardar
            </button>

            <a asp-page="./Index" class="btn btn-secondary ml-2">
                <i class="fas fa-arrow-left"></i> Volver
            </a>

        </form>

    </div>
</div>
