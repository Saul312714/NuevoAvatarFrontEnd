@page
@model NuevoAvatarFront.Pages.ADM19_SAUL.IndexModel
@{
    ViewData["Title"] = "Listados por período";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 text-gray-800">Listado de Matrículas por período</h1>
</div>

<!-- MENSAJES -->
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}
@if (!string.IsNullOrEmpty(Model.MensajeOk))
{
    <div class="alert alert-success">@Model.MensajeOk</div>
}

<!-- FILTROS -->
<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="fw-bold text-gray-800">Período</label>
        <select class="form-control shadow-sm"
                asp-for="FiltroPeriodo"
                asp-items="Model.Periodos">
            <option value="">-- Todos --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="fw-bold text-gray-800">Carrera</label>
        <select class="form-control shadow-sm"
                asp-for="FiltroCarrera"
                asp-items="Model.Carreras">
            <option value="">-- Todas --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="fw-bold text-gray-800">Curso</label>
        <select class="form-control shadow-sm"
                asp-for="FiltroCurso"
                asp-items="Model.Cursos">
            <option value="">-- Todos --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="fw-bold text-gray-800">Grupo</label>
        <select class="form-control shadow-sm"
                asp-for="FiltroGrupo"
                asp-items="Model.Grupos">
            <option value="">-- Todos --</option>
        </select>
    </div>

    <div class="col-12 d-flex justify-content-end mt-2">
        <button type="submit" class="btn btn-primary me-2">
            <i class="fas fa-filter"></i> Aplicar filtros
        </button>
        <a asp-page="./Index" class="btn btn-secondary">
            Limpiar
        </a>
    </div>
</form>

<div class="card shadow">
    <div class="card-body">

        @if (Model.Resultados is null || !Model.Resultados.Any())
        {
            <div class="alert alert-info text-center">
                No hay registros para los filtros seleccionados.
            </div>
        }
        else
        {
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <!-- Llave / ID -->
                        <th>ID Matrícula</th>
                        <!-- Tipo, Identificación, Nombre -->
                        <th>Tipo ID</th>
                        <th>Identificación</th>
                        <th>Nombre</th>
                        <!-- Carrera, Curso, Grupo -->
                        <th>Carrera</th>
                        <th>Curso</th>
                        <th>Grupo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Resultados)
                    {
                        <tr>
                            <td>@row.ID_Matricula</td>
                            <td>@row.Tipo_Identificacion</td>
                            <td>@row.Identificacion</td>
                            <td>@row.Nombre</td>

                            <!-- Carrera se resuelve a partir del curso -->
                            <td>@Model.ObtenerNombreCarreraPorCurso(row.ID_Curso)</td>
                            <td>@Model.ObtenerNombreCurso(row.ID_Curso)</td>
                            <td>@Model.ObtenerTextoGrupo(row.ID_Grupo)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- PAGINACIÓN (usa Model.Total y Model.size desde el IndexModel) -->
            <nav aria-label="Paginación" class="mt-3">
                <ul class="pagination mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.page ? "active" : "")">
                            <a class="page-link"
                               href="?FiltroPeriodo=@Model.FiltroPeriodo&FiltroCarrera=@Model.FiltroCarrera&FiltroCurso=@Model.FiltroCurso&FiltroGrupo=@Model.FiltroGrupo&page=@i&size=@Model.size&sort=@Model.sort&asc=@Model.asc">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <!-- BOTONES DE EXPORTACIÓN -->
        <div class="mt-3 d-flex justify-content-end gap-2">

            <!-- CSV -->
            <a asp-page="./Index"
               asp-page-handler="ExportCsv"
               asp-route-FiltroPeriodo="@Model.FiltroPeriodo"
               asp-route-FiltroCarrera="@Model.FiltroCarrera"
               asp-route-FiltroCurso="@Model.FiltroCurso"
               asp-route-FiltroGrupo="@Model.FiltroGrupo"
               asp-route-page="@Model.page"
               asp-route-size="@Model.size"
               asp-route-sort="@Model.sort"
               asp-route-asc="@Model.asc"
               class="btn btn-outline-primary btn-sm">
                <i class="fas fa-file-csv"></i> Exportar CSV
            </a>

            <!-- PDF -->
            <a asp-page="./Index"
               asp-page-handler="ExportPdf"
               asp-route-FiltroPeriodo="@Model.FiltroPeriodo"
               asp-route-FiltroCarrera="@Model.FiltroCarrera"
               asp-route-FiltroCurso="@Model.FiltroCurso"
               asp-route-FiltroGrupo="@Model.FiltroGrupo"
               asp-route-page="@Model.page"
               asp-route-size="@Model.size"
               asp-route-sort="@Model.sort"
               asp-route-asc="@Model.asc"
               class="btn btn-outline-danger btn-sm ms-2">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </a>
        </div>
    </div>
</div>
