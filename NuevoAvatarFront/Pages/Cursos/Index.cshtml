@page
@model NuevoAvatarFront.Pages.Cursos.IndexModel
@{
    ViewData["Title"] = "Administrar Cursos";
    Layout = "_Layout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Cursos</h6>

        <a asp-page="/Cursos/Upsert" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Crear Curso
        </a>
    </div>

    <div class="card-body">
        <div class="table-responsive">

            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Curso</th>
                        <th>Carrera</th>
                        <th>Nivel</th>
                        <th style="width:150px">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Cursos)
                    {
                        <tr>
                            <td>@item.ID_Curso</td>
                            <td>@item.Nombre</td>
                            <td>@item.NombreCarrera</td>
                            <td>@item.Nivel</td>
                            <td>

                                <!-- EDITAR -->
                                <a asp-page="/Cursos/Upsert"
                                   asp-route-id="@item.ID_Curso"
                                   class="btn btn-info btn-sm">
                                    <i class="fas fa-edit"></i> Editar
                                </a>

                                <!-- ELIMINAR -->
                                <button class="btn btn-danger btn-sm"
                                        onclick="confirmarEliminacion(@item.ID_Curso)">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        // ALERTA DE ÉXITO
        @if (TempData["Success"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Éxito',
                    text: '@TempData["Success"]',
                    timer: 2000,
                    showConfirmButton: false
                });
                </text>
        }

        // ALERTA DE ERROR
        @if (TempData["Error"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '@TempData["Error"]',
                    showConfirmButton: true
                });
                </text>
        }

        // Confirmación de eliminación
        function confirmarEliminacion(id) {
            Swal.fire({
                title: "¿Eliminar curso?",
                text: "Esta acción no se puede deshacer.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `?handler=Delete&id=${id}`;
                }
            });
        }

        // DataTable
        $(document).ready(function () {
            $('#dataTable').DataTable();
        });

    </script>

}
