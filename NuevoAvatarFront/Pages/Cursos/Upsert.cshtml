@page "{id:int?}"
@model NuevoAvatarFront.Pages.Cursos.UpsertModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Curso" : "Nuevo Curso";
    Layout = "_Layout";
}

<div class="card shadow">

    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            @(Model.EsEdicion ? "Editar Curso" : "Nuevo Curso")
        </h6>
    </div>

    <div class="card-body">

        <!-- EL FIX MÁS IMPORTANTE: enviar correctamente el ID -->
        <form method="post" asp-route-id="@Model.Curso.ID_Curso">

            <!-- Segundo FIX: enviar ID en el POST -->
            @if (Model.EsEdicion)
            {
                <input type="hidden" asp-for="Curso.ID_Curso" />
            }

            <!-- Nombre -->
            <div class="mb-3">
                <label class="form-label">Nombre del curso</label>
                <input asp-for="Curso.Nombre" class="form-control" />
                <span asp-validation-for="Curso.Nombre" class="text-danger"></span>
            </div>

            <!-- Nivel -->
            <div class="mb-3">
                <label class="form-label">Nivel (1 - 12)</label>
                <input asp-for="Curso.Nivel" type="number" class="form-control" min="1" max="12" />
                <span asp-validation-for="Curso.Nivel" class="text-danger"></span>
            </div>

            <!-- Carrera -->
            <div class="mb-3">
                <label class="form-label">Carrera</label>
                <select asp-for="Curso.ID_Carrera" class="form-select" asp-items="Model.Carreras">
                    <option value="">Seleccione una carrera</option>
                </select>
                <span asp-validation-for="Curso.ID_Carrera" class="text-danger"></span>
            </div>

            <!-- BOTONES -->
            <div class="d-flex justify-content-between">
                <a asp-page="/Cursos/Index" class="btn btn-secondary">Volver</a>

                <button type="submit" class="btn btn-primary">
                    @(Model.EsEdicion ? "Guardar Cambios" : "Crear Curso")
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Validación de nombre (solo letras y espacios)
        document.querySelector("input[name='Curso.Nombre']")
            .addEventListener("input", function () {
                const regex = /^[A-Za-zÁÉÍÓÚáéíóúñÑ ]*$/;
                if (!regex.test(this.value))
                    this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúñÑ ]+/g, '');
            });
    </script>
}
