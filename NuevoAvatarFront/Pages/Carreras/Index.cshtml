@page
@model NuevoAvatarFront.Pages.Carreras.IndexModel
@{
    ViewData["Title"] = "Administrar Carreras";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 text-gray-800">Listado de Carreras</h1>
    <a asp-page="/Carreras/Upsert" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nueva Carrera
    </a>
</div>

<!-- FILTRO POR INSTITUCIÓN -->
<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="fw-bold text-gray-800">Institución</label>
        <select class="form-control shadow-sm" asp-for="FiltroInstitucionID" asp-items="Model.Instituciones">
            <option value="0">-- Todas --</option>
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary shadow me-2">
            <i class="fas fa-filter"></i> Aplicar filtros
        </button>
        <a asp-page="/Carreras/Index" class="btn btn-secondary shadow">Limpiar</a>
    </div>
</form>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Carreras.Any())
        {
            <div class="alert alert-info text-center">
                No hay carreras para mostrar.
            </div>
        }
        else
        {
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Institución</th>
                        <th>Director</th>
                        <th style="width:150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var carrera in Model.Carreras)
                    {
                        <tr>
                            <td>@carrera.ID_Carrera</td>
                            <td>@carrera.Nombre</td>
                            <td>@Model.ObtenerNombreInstitucion(carrera.ID_Institucion)</td>
                            <td>@Model.ObtenerNombreDirector(carrera.ID_Profesor_Director)</td>
                            <td>
                                <a asp-page="/Carreras/Upsert"
                                   asp-route-id="@carrera.ID_Carrera"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>
                                <a asp-page="/Carreras/Delete"
                                   asp-route-id="@carrera.ID_Carrera"
                                   class="btn btn-sm btn-danger">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <script>
        Swal.fire({
            icon: "error",
            title: "Error",
            text: "@Model.ErrorMessage"
        });
    </script>
}