@page "{id?}"
@model NuevoAvatarFront.Pages.Roles.UpsertModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Rol" : "Nuevo Rol";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
        <a href="/Roles/Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Rol.ID_Rol" />

            <div class="mb-3">
                <label class="form-label">Nombre del Rol</label>
                <input asp-for="Rol.Nombre" class="form-control" placeholder="Ej: Administrador" required />
                <span asp-validation-for="Rol.Nombre" class="text-danger"></span>
            </div>

            <div class="text-end">
                <a href="/Roles/Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    @(Model.EsEdicion ? "Actualizar" : "Crear")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
