@page
@model NuevoAvatarFront.Pages.Expedientes.IndexModel
@{
    ViewData["Title"] = "Expedientes";
}

<div class="d-flex justify-content-between mb-3">
    <h4 class="text-primary mb-0">Listado de Expedientes</h4>

    <a asp-page="Upsert" class="btn btn-primary btn-sm">
        <i class="fas fa-plus"></i> Nuevo
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
                <thead class="thead-light">
                    <tr>
                        <th>Identificación</th>
                        <th>Tipo</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Provincia</th>
                        <th>Cantón</th>
                        <th>Distrito</th>
                        <th style="width: 170px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var x in Model.Lista)
                    {
                        <tr>
                            <td>@x.Identificacion</td>
                            <td>@x.Tipo_Identificacion</td>
                            <td>@x.Nombre</td>
                            <td>@x.Email</td>
                            <td>@x.Provincia</td>
                            <td>@x.Canton</td>
                            <td>@x.Distrito</td>

                            <td>
                                <a asp-page="Upsert"
                                   asp-route-id="@x.ID_Estudiante"
                                   class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Editar
                                </a>

                                <a asp-page-handler="Eliminar"
                                   asp-route-id="@x.ID_Estudiante"
                                   class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
