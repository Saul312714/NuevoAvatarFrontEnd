@using NuevoAvatarFront.Services
@inject IHttpContextAccessor Http
@inject IModuloApiClient ModuloApi
@inject IRolModuloApiClient RolModuloApi

@{
    var rolId = Http.HttpContext?.Session.GetInt32("RolID") ?? 0;
    var permisos = await RolModuloApi.GetByRolAsync(rolId);
    var modulos = await ModuloApi.GetAllAsync();

    // filtrar solo los módulos permitidos
    var visibles = modulos
        .Where(m => permisos.Any(p => p.ID_Modulo == m.ID_Modulo && p.PuedeVer))
        .OrderBy(m => m.Orden)
        .ToList();
}

<ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion">

    <!-- Logo -->
    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/Dashboard/Index">
        <img src="/images/logo.png" width="40" height="40" class="me-2" />
    </a>

    <hr class="sidebar-divider my-0">

    @if (visibles.Count == 0)
    {
        <li class="nav-item mt-4 text-center text-warning">
            <span>No tienes módulos asignados</span>
        </li>
    }
    else
    {
        foreach (var m in visibles)
        {
            <li class="nav-item">
                <a class="nav-link" href="@m.Url">
                    <span>@m.Nombre</span>
                </a>
            </li>
        }
    }

    <hr class="sidebar-divider d-none d-md-block">
</ul>
