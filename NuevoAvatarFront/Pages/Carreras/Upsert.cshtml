@page "{id?}"
@model NuevoAvatarFront.Pages.Carreras.UpsertModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Carrera" : "Crear Carrera";
    Layout = "_Layout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            @ViewData["Title"]
        </h6>
    </div>

    <div class="card-body">

        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Carrera.ID_Carrera" />

            <!-- Nombre -->
            <div class="mb-3">
                <label class="form-label">Nombre de la Carrera</label>
                <input asp-for="Carrera.Nombre" class="form-control" />
                <span asp-validation-for="Carrera.Nombre" class="text-danger"></span>
            </div>

            <!-- Institución -->
            <div class="mb-3">
                <label class="form-label">Institución</label>
                <select class="form-select" asp-for="Carrera.ID_Institucion" asp-items="Model.Instituciones">
                    <option value="">-- Seleccionar --</option>
                </select>
                <span asp-validation-for="Carrera.ID_Institucion" class="text-danger"></span>
            </div>

            <!-- Director -->
            <div class="mb-3">
                <label class="form-label">Director de Carrera</label>
                <select class="form-select" asp-for="Carrera.ID_Profesor_Director" asp-items="Model.Profesores">
                    <option value="">-- Seleccionar --</option>
                </select>
                <span asp-validation-for="Carrera.ID_Profesor_Director" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-page="/Carreras/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> @Model.BotonTexto
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <script>
        Swal.fire({
            icon: "error",
            title: "Error",
            text: "@Model.ErrorMessage",
        });
    </script>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <script>
        Swal.fire({
            icon: "success",
            title: "Éxito",
            text: "@Model.SuccessMessage",
            timer: 1800,
            showConfirmButton: false
        }).then(() => {
            window.location.href = "/Carreras/Index";
        });
    </script>
}
