@page
@model NuevoAvatarFront.Pages.Cursos.CreateModel
@{
    ViewData["Title"] = "Crear Curso";
}

<h2>Nuevo Curso</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Form.Nombre" class="form-control" />
        <span asp-validation-for="Form.Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Nivel</label>
        <input asp-for="Form.Nivel" type="number" class="form-control" min="1" max="12" />
        <span asp-validation-for="Form.Nivel" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Carrera</label>
        <select asp-for="Form.CarreraId" class="form-select">
            @foreach (var carrera in Model.Carreras)
            {
                <option value="@carrera.Id">@carrera.Nombre</option>
            }
        </select>
        <span asp-validation-for="Form.CarreraId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Crear</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>

<partial name="_ValidationScriptsPartial" />
