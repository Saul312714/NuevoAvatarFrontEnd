@page
@model NuevoAvatarFront.Pages.Carreras.IndexModel
@{
    ViewData["Title"] = "Administrar Carreras";
    Layout = "_Layout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Carreras</h6>

        <a asp-page="/Carreras/Upsert" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Nueva Carrera
        </a>
    </div>

    <div class="card-body">
        <!-- FILTRO POR INSTITUCIÓN -->
        <form method="get" class="mb-3">
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Institución</label>
                    <select class="form-select" asp-for="FiltroInstitucionID" asp-items="Model.Instituciones">
                        <option value="0">-- Todas --</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filtrar
                    </button>
                </div>
            </div>
        </form>

        <!-- TABLA -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Institución</th>
                        <th>Director</th>
                        <th style="width: 150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var carrera in Model.Carreras)
                    {
                        <tr>
                            <td>@carrera.ID_Carrera</td>
                            <td>@carrera.Nombre</td>
                            <td>@Model.ObtenerNombreInstitucion(carrera.ID_Institucion)</td>
                            <td>@Model.ObtenerNombreDirector(carrera.ID_Profesor_Director)</td>
                            <td>
                                <a asp-page="/Carreras/Upsert"
                                   asp-route-id="@carrera.ID_Carrera"
                                   class="btn btn-info btn-sm">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a asp-page="/Carreras/Delete"
                                   asp-route-id="@carrera.ID_Carrera"
                                   class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>


            </table>

            @if (!Model.Carreras.Any())
            {
                <div class="alert alert-info text-center">
                    No hay carreras para mostrar.
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <script>
        Swal.fire({
            icon: "error",
            title: "Error",
            text: "@Model.ErrorMessage"
        });
    </script>
}
