@page
@model NuevoAvatarFront.Pages.Grupos.IndexModel
@{
    ViewData["Title"] = "Grupos";
}

<div class="d-flex justify-content-between mb-3">
    <h4 class="text-primary mb-0">Listado de Grupos</h4>

    <a asp-page="Upsert" class="btn btn-primary btn-sm">
        <i class="fas fa-plus"></i> Nuevo
    </a>
</div>

<!-- MENSAJE DE ERROR DE ADM13 -->
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<div class="card shadow">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th>N° Grupo</th>
                        <th>Curso</th>
                        <th>Profesor</th>
                        <th>Periodo</th>
                        <th>Horario</th>
                        <th style="width: 170px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Lista.Any())
                    {
                        foreach (var g in Model.Lista)
                        {
                            <tr>
                                <td>@g.ID_Grupo</td>
                                <td>@g.Numero</td>
                                <td>@g.NombreCurso</td>
                                <td>@g.NombreProfesor</td>
                                <td>@g.NombrePeriodo</td>
                                <td>@g.Horario</td>

                                <td class="text-center">

                                    <!-- EDITAR -->
                                    <a asp-page="Upsert"
                                       asp-route-id="@g.ID_Grupo"
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>

                                    <!-- ELIMINAR (OnPostDeleteAsync) -->
                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@g.ID_Grupo"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i> Eliminar
                                        </button>
                                    </form>

                                    <!--  DESGLOSE DE RUBROS  -->
                                    <a asp-page="/NotasDesglose/Desglose"
                                       asp-route-idGrupo="@g.ID_Grupo"
                                       class="btn btn-info btn-sm mt-1">
                                        <i class="fas fa-list"></i> Rubros
                                    </a>

                                    <!--  ASIGNAR NOTAS  -->
                                    <a asp-page="/NotasDesglose/Notas"
                                       asp-route-idGrupo="@g.ID_Grupo"
                                       class="btn btn-success btn-sm mt-1">
                                        <i class="fas fa-pen"></i> Notas
                                    </a>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                No hay grupos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
