@page
@model NuevoAvatarFront.Pages.Carreras.IndexModel
@{
    ViewData["Title"] = "Administrar Carreras";
    Layout = "_Layout";
}

<div class="card shadow mb-4">

    <!-- HEADER -->
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Carreras</h6>

        <a asp-page="/Carreras/Upsert" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Nueva Carrera
        </a>
    </div>

    <div class="card-body">

        <!-- FILTRO POR INSTITUCIÓN -->
        <form method="get" class="row g-3 mb-4">

            <div class="col-md-4">
                <label class="form-label fw-bold">Institución</label>
                <select name="FiltroInstitucion"
                        class="form-select shadow-sm"
                        onchange="this.form.submit()">
                    <option value="">— Todas —</option>

                    @foreach (var inst in Model.Instituciones)
                    {
                        <option value="@inst.ID_Institucion"
                                selected="@(Model.FiltroInstitucion == inst.ID_Institucion)">
                            @inst.Nombre
                        </option>
                    }
                </select>
            </div>

        </form>

        <!-- TABLA -->
        <div class="table-responsive">

            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Institución</th>
                        
                        <th style="width:150px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in Model.Carreras)
                    {
                        <tr>
                            <td>@c.Nombre</td>
                            <td>@c.NombreInstitucion</td>
                           
                            <td>

                                <!-- EDITAR -->
                                <a class="btn btn-info btn-sm"
                                   href="/Carreras/Upsert?id=@c.ID_Carrera">
                                    <i class="fas fa-edit"></i> Editar
                                </a>

                                <!-- ELIMINAR -->
                                <a class="btn btn-danger btn-sm"
                                   href="/Carreras/Delete?id=@c.ID_Carrera">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                               



                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DATATABLE -->
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable();
        });
    </script>

    <!-- ALERTAS DE EXITO O ERROR -->
    @if (TempData["Success"] != null)
    {
        <text>
            Swal.fire({
            icon: 'success',
            title: 'Éxito',
            text: '@TempData["Success"]',
            timer: 2000,
            showConfirmButton: false
            });
        </text>
    }

    @if (TempData["Error"] != null)
    {
        <text>
            Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@TempData["Error"]',
            showConfirmButton: true
            });
        </text>
    }
}
