@page
@model NuevoAvatarFront.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Panel de Bienvenida";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Bienvenido, @Model.Data.NombreUsuario</h1>
    <span class="badge badge-info badge-pill">@Model.Data.RolUsuario</span>
</div>


@if (Model.Data.RolUsuario.Contains("Administrador") || Model.Data.RolUsuario.Contains("Admin"))
{
    <div class="row">

        <!-- Usuarios -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                        Usuarios
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.TotalUsuarios
                    </div>
                </div>
            </div>
        </div>

        <!-- Carreras -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                        Carreras
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.TotalCarreras
                    </div>
                </div>
            </div>
        </div>

        <!-- Cursos -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                        Cursos
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.TotalCursos
                    </div>
                </div>
            </div>
        </div>

        <!-- Períodos Activos -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-secondary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">
                        Períodos Activos
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.TotalPeriodosActivos
                    </div>
                </div>
            </div>
        </div>

        <!-- Facturas Pendientes -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                        Facturas Pendientes
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.TotalFacturasPendientes
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@if (Model.Data.RolUsuario.Contains("Estudiante"))
{
    <div class="row">

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                        Mis Matrículas
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.MisMatriculas
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                        Cursos Actuales
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.MisCursosActuales
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                        Saldo Pendiente
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        ₡@Model.Data.MiSaldoPendiente.ToString("N0")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                        Mi Carrera
                    </div>
                    <div class="h6 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.MiCarrera
                    </div>
                </div>
            </div>
        </div>

    </div>
}


@if (Model.Data.RolUsuario.Contains("Profesor"))
{
    <div class="row">

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                        Mis Grupos
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.MisGrupos
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                        Cursos que Imparto
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                        @Model.Data.CursosQueImparto
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                        Período Actual
                    </div>
                    <div class="h6 mb-0 font-weight-bold text-gray-800">
                        2025-1
                    </div>
                </div>
            </div>
        </div>

    </div>
}

<div class="row">

    <!-- NOTIFICACIONES -->
    <div class="col-lg-6">
        <div class="card shadow mb-4">

            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Notificaciones recientes</h6>
                <span class="badge badge-primary">@Model.Data.Notificaciones.Count</span>
            </div>

            <div class="card-body">
                @if (Model.Data.Notificaciones.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm">
                            <thead class="thead-light">
                                <tr>
                                    <th>Destino</th>
                                    <th>Asunto</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var n in Model.Data.Notificaciones)
                                {
                                    <tr>
                                        <td>@n.Email_Destino</td>
                                        <td>@n.Asunto</td>
                                        <td>@n.FechaEnvio.ToString("dd/MM HH:mm")</td>
                                        <td><span class="badge badge-success">@n.Estado</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No hay notificaciones recientes.</p>
                }
            </div>

        </div>
    </div>

    <!-- BITÁCORAS (solo admin) -->
    @if (Model.Data.RolUsuario.Contains("Admin"))
    {
        <div class="col-lg-6">
            <div class="card shadow mb-4">

                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Últimas bitácoras</h6>
                    <span class="badge badge-primary">@Model.Data.Bitacoras.Count</span>
                </div>

                <div class="card-body">
                    @if (Model.Data.Bitacoras.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Usuario</th>
                                        <th>Acción</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in Model.Data.Bitacoras)
                                    {
                                        <tr>
                                            <td>
                                                @(Model.Data.UsuariosLookup.ContainsKey(b.ID_Usuario)
                                                                                    ? Model.Data.UsuariosLookup[b.ID_Usuario]
                                                                                    : $"Usuario {b.ID_Usuario}")
                                            </td>
                                            <td>@b.Accion</td>
                                            <td>@b.Fecha.ToString("dd/MM HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Sin registros recientes.</p>
                    }
                </div>

            </div>
        </div>
    }
</div>



<div class="text-center mb-4">
    <a href="#" class="btn btn-outline-primary btn-sm" data-toggle="modal" data-target="#modalAyuda">
        <i class="fas fa-question-circle"></i> Ayuda
    </a>

    <a href="#" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-user"></i> Mi Perfil
    </a>
</div>



<div class="modal fade" id="modalAyuda" tabindex="-1" role="dialog" aria-labelledby="modalAyudaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalAyudaLabel">
                    <i class="fas fa-life-ring"></i> Centro de Ayuda & Soporte
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- FAQ -->
                <h5 class="font-weight-bold text-primary mb-3">
                    <i class="fas fa-question-circle"></i> Preguntas Frecuentes (FAQ)
                </h5>

                <ul class="list-group mb-4">

                    <li class="list-group-item">
                        <strong>¿Cómo actualizo mi expediente?</strong><br />
                        Desde el menú lateral: <em>Académico → Expedientes → Editar</em>.
                    </li>

                    <li class="list-group-item">
                        <strong>¿Qué hago si mis datos personales son incorrectos?</strong><br />
                        Debés contactar a soporte para solicitar una actualización.
                    </li>

                    <li class="list-group-item">
                        <strong>No puedo acceder al sistema</strong><br />
                        Verificá tu correo y contraseña o escribí a soporte técnico.
                    </li>

                    <li class="list-group-item">
                        <strong>No veo mis cursos</strong><br />
                        Solo se muestran cursos activos en el periodo vigente.
                    </li>

                </ul>

                <hr />

                <!-- CONTACTO -->
                <h5 class="font-weight-bold text-primary mb-3">
                    <i class="fas fa-headset"></i> Información de Contacto
                </h5>

                <p class="mb-1">
                    <strong>Email:</strong> soporte@cuc.ac.cr
                </p>

                <p class="mb-1">
                    <strong>Teléfono:</strong> +506 8888-8888
                </p>

                <p>
                    <strong>Horario:</strong> Lunes a Viernes, 8:00am – 5:00pm
                </p>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>

    </div>
</div>