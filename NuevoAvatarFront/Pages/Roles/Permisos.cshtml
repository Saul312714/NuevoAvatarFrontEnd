@page
@model NuevoAvatarFront.Pages.Roles.PermisosModel
@{
    Layout = "_Layout";
}

<div class="card shadow mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="text-primary m-0">
            Permisos del Rol: <strong>@Model.NombreRol</strong>
        </h4>

        <a asp-page="/Roles/Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card-body">

        <form method="post">

            <input type="hidden" asp-for="ID_Rol" />

            <table class="table table-bordered table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>Icono</th>
                        <th>Módulo</th>
                        <th>URL</th>
                        <th>Orden</th>
                        <th style="width:120px;">Puede Ver</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Modulos.Count; i++)
                    {
                        var modulo = Model.Modulos[i];
                        var permiso = Model.Permisos[i];

                        <tr>
                            <td><i class="@modulo.Icono"></i></td>
                            <td>@modulo.Nombre</td>
                            <td>@modulo.Url</td>
                            <td>@modulo.Orden</td>

                            <td class="text-center">
                                <input type="checkbox"
                                       asp-for="Permisos[@i].PuedeVer"
                                       class="form-check-input" />

                                <input type="hidden" asp-for="Permisos[@i].ID_Modulo" />
                                <input type="hidden" asp-for="Permisos[@i].ID_Rol" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-3 text-end">
                <button class="btn btn-primary">
                    <i class="fas fa-save"></i> Guardar Permisos
                </button>
            </div>

        </form>

    </div>
</div>
