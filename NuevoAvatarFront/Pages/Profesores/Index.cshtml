@page
@model NuevoAvatarFront.Pages.Profesores.IndexModel
@{
    ViewData["Title"] = "Profesores";
    Layout = "_Layout";
}

@if (TempData["ok"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["err"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}
@if (TempData["error"] is string err2)
{
    <div class="alert alert-danger">@err2</div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Profesores</h6>
        <div>
            <a asp-page="./Upsert" class="btn btn-success btn-sm">
                <i class="fas fa-plus"></i> Nuevo
            </a>
        </div>
    </div>

    <div class="card-body">
        <form id="filtrosForm" method="get" class="row g-2 mb-3">
            <div class="col-md-5">
                <input name="q" value="@Model.q" class="form-control"
                       placeholder="Buscar por nombre, email o identificación..." />
            </div>

            <div class="col-md-3">
                <select asp-for="sort" asp-items="Model.SortOptions" class="form-select"></select>
            </div>

            <div class="col-md-2">
                <select asp-for="size" asp-items="Model.SizeOptions" class="form-select"></select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th style="width: 180px;">Identificación</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th style="width: 190px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Profesores)
                    {
                        <tr>
                            <td>@p.ID_Profesor</td>
                            <td>@p.Tipo_Identificacion - @p.Identificacion</td>
                            <td>@p.Nombre</td>
                            <td>@p.Email</td>
                            <td class="text-end">
                                <a asp-page="./Upsert" asp-route-id="@p.ID_Profesor" class="btn btn-info btn-sm me-1">
                                    <i class="fas fa-edit"></i> Modificar
                                </a>
                                <a asp-page="./Eliminar" asp-route-id="@p.ID_Profesor" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var pages = (int)Math.Ceiling((double)Model.Total / Math.Max(Model.size, 1));
            if (pages < 1) { pages = 1; }
        }
        <nav aria-label="Paginación" class="mt-3">
            <ul class="pagination mb-0">
                @for (int i = 1; i <= pages; i++)
                {
                    <li class="page-item @(i == Model.page ? "active" : "")">
                        <a class="page-link" href="?q=@Model.q&sort=@Model.sort&page=@i&size=@Model.size">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-submit al cambiar Orden/Tamaño y al presionar Enter en búsqueda
        (function () {
            const form = document.getElementById('filtrosForm');
            const sort = form.querySelector('[name="sort"]');
            const size = form.querySelector('[name="size"]');
            const q    = form.querySelector('[name="q"]');

            sort.addEventListener('change', () => form.submit());
            size.addEventListener('change', () => form.submit());
            q.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); form.submit(); }
            });
        })();

        // Si usas DataTables, que no interfiera con la paginación servidor
        $(function () {
            if ($.fn.DataTable) {
                $('#dataTable').DataTable({
                    paging: false,
                    searching: false,
                    info: false
                });
            }
        });
    </script>
}
