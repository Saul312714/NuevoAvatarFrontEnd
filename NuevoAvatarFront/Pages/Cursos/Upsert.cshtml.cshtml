@page "{id?}"
@model NuevoAvatarFront.Pages.Cursos.UpsertModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Curso" : "Crear Curso";
    Layout = "_Layout";
}

<div class="card shadow mb-4">

    <!-- HEADER -->
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas @(Model.EsEdicion ? "fa-edit" : "fa-plus")"></i>
            @ViewData["Title"]
        </h6>
    </div>

    <div class="card-body">

        <form method="post" class="row g-3">

            <!-- CARRERA -->
            <div class="col-md-6">
                <label class="form-label fw-bold">Carrera</label>
                <select asp-for="Curso.ID_Carrera"
                        class="form-control shadow-sm"
                        required>
                    <option value="">Seleccione una carrera</option>

                    @foreach (var carrera in Model.Carreras)
                    {
                        <option value="@carrera.ID_Carrera">
                            @carrera.Nombre
                        </option>
                    }
                </select>
                <span asp-validation-for="Curso.ID_Carrera" class="text-danger"></span>
            </div>

            <!-- NOMBRE DEL CURSO -->
            <div class="col-md-6">
                <label class="form-label fw-bold">Nombre del curso</label>
                <input asp-for="Curso.Nombre"
                       class="form-control shadow-sm"
                       placeholder="Ej: Matemática I"
                       required />
                <span asp-validation-for="Curso.Nombre" class="text-danger"></span>
            </div>

            <!-- NIVEL -->
            <div class="col-md-4">
                <label class="form-label fw-bold">Nivel</label>
                <input asp-for="Curso.Nivel"
                       type="number"
                       min="1" max="12"
                       class="form-control shadow-sm"
                       placeholder="1 a 12"
                       required />
                <span asp-validation-for="Curso.Nivel" class="text-danger"></span>
            </div>

            <!-- BOTONES -->
            <div class="col-12 text-end mt-4">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-save"></i> Guardar
                </button>

                <a asp-page="/Cursos/Index" class="btn btn-outline-secondary btn-sm ms-2">
                    <i class="fas fa-arrow-left"></i> Cancelar
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Validación del nombre del curso (solo letras y espacios)
        document.getElementById("Curso_Nombre").addEventListener("input", function () {
            const regex = /^[A-Za-zÁÉÍÓÚáéíóúñÑ ]*$/;
            if (!regex.test(this.value)) {
                this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúñÑ ]/g, "");
            }
        });
    </script>
}
