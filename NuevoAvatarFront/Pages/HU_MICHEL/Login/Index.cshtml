@page
@model NuevoAvatarFront.Pages.HU_MICHEL.Login.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Inicio de sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Login - Nuevo Avatar</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/css/sb-admin-2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body class="bg-gradient-primary">

    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="card shadow-lg my-5">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <h1 class="h4 text-gray-900 mb-4">Bienvenido a Nuevo Avatar</h1>
                        </div>

                        @* Mensaje de error (login incorrecto) *@
                        @if (Model.ErrorMessage != null)
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }

                        @* Formulario de login *@
                        <form method="post">
                            <div class="form-group mb-3">
                                <input asp-for="Email" type="email" class="form-control form-control-user"
                                       placeholder="Correo institucional" required />
                            </div>

                            <div class="form-group mb-3">
                                <input asp-for="Password" type="password" class="form-control form-control-user"
                                       placeholder="Contraseña" required />
                            </div>

                            <button type="submit" class="btn btn-primary btn-user w-100">
                                <i class="fas fa-sign-in-alt"></i> Iniciar sesión
                            </button>

                            <div class="form-check mt-3">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">Recordarme</label>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        if (params.get("logout") === "1") {
            Swal.fire({
                icon: "success",
                title: "Sesión cerrada",
                text: "Has salido del sistema correctamente.",
                timer: 2000,
                showConfirmButton: false
            });
            sessionStorage.clear();
            localStorage.clear();
            console.log("Tokens limpiados en logout");
        }
    </script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/js/sb-admin-2.min.js"></script>
</body>
</html>
