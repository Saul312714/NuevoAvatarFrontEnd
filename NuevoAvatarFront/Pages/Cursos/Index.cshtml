@page
@model NuevoAvatarFront.Pages.Cursos.IndexModel
@{
    ViewData["Title"] = "Cursos";
}
<h2>Listado de Cursos</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Carrera</label>
        <select name="CarreraId" class="form-select" onchange="this.form.submit()">
            @foreach (var carrera in Model.Carreras)
            {
                <option value="@carrera.Id" selected="@(carrera.Id == Model.CarreraId)">
                    @carrera.Nombre
                </option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Nivel</label>
        <input type="number" name="Nivel" value="@Model.Nivel" class="form-control" min="1" max="12" onchange="this.form.submit()" />
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Nivel</th>
            <th>Carrera</th>
            <th>Grupos Vinculados</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var curso in Model.Cursos)
        {
            <tr>
                <td>@curso.Nombre</td>
                <td>@curso.Nivel</td>
                <td>@curso.CarreraNombre</td>
                <td>@curso.GruposVinculados</td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@curso.Id" class="btn btn-sm btn-secondary">Editar</a>
                    <a asp-page="Delete" asp-route-id="@curso.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>