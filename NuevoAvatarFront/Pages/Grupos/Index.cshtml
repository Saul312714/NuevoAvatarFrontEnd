@page
@model NuevoAvatarFront.Pages.Grupos.IndexModel
@{
    ViewData["Title"] = "Administración de Grupos";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Grupos</h6>
        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#grupoModal"><i class="fas fa-plus"></i> Nuevo</button>
    </div>
    <div class="card-body">
        <table class="table table-bordered" id="dataTable">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Curso</th>
                    <th>Profesor</th>
                    <th>Horario</th>
                    <th>Periodo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Grupos)
                {
                    <tr>
                        <td>@g.Numero</td>
                        <td>@g.Curso</td>
                        <td>@g.Profesor</td>
                        <td>@g.Horario</td>
                        <td>@g.Periodo</td>
                        <td>
                            <a href="#" class="btn btn-info btn-sm"><i class="fas fa-edit"></i></a>
                            <a href="#" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $('#dataTable').DataTable();
    </script>
}