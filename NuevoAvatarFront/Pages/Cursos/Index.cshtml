@page
@model NuevoAvatarFront.Pages.Cursos.IndexModel
@{
    ViewData["Title"] = "Administrador Cursos";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 text-gray-800">Listado de Cursos</h1>
    <a asp-page="/Cursos/Upsert" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nuevo Curso
    </a>
</div>

<!-- FILTROS -->
<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="fw-bold text-gray-800">Carrera</label>
        <select asp-for="FiltroCarrera" class="form-control shadow-sm" asp-items="Model.Carreras">
            <option value="">-- Todas --</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="fw-bold text-gray-800">Nivel</label>
        <select asp-for="FiltroNivel" class="form-control shadow-sm">
            <option value="">-- Todos --</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i">@i</option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary shadow me-2">
            <i class="fas fa-filter"></i> Aplicar filtros
        </button>
        <a asp-page="/Cursos/Index" class="btn btn-secondary shadow">Limpiar</a>
    </div>
</form>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Cursos.Count == 0)
        {
            <div class="alert alert-info text-center">
                No hay cursos disponibles.
            </div>
        }
        else
        {
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Carrera</th>
                        <th>Nivel</th>
                        <th style="width:150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Cursos)
                    {
                        <tr>
                            <td>@item.ID_Curso</td>
                            <td>@item.Nombre</td>
                            <td>@Model.ObtenerNombreCarrera(item.ID_Carrera)</td>
                            <td>@item.Nivel</td>
                            <td>
                                <a asp-page="/Cursos/Upsert" asp-route-id="@item.ID_Curso"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>
                                <a asp-page="/Cursos/Delete" asp-route-id="@item.ID_Curso"
                                   class="btn btn-sm btn-danger">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>