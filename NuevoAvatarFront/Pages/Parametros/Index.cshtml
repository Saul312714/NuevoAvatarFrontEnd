@page
@model NuevoAvatarFront.Pages.Parametros.IndexModel
@{
    ViewData["Title"] = "Parámetros del sistema";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Parámetros</h6>
        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#paramModal">
            <i class="fas fa-plus"></i> Nuevo
        </button>
    </div>
    <div class="card-body">
        <table class="table table-bordered" id="dataTable" width="100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Valor</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Parametros)
                {
                    <tr>
                        <td>@p.ID_Parametro</td>
                        <td>@p.Valor</td>
                        <td>
                            <button class="btn btn-info btn-sm" data-toggle="modal" data-target="#paramModal" data-id="@p.ID_Parametro"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-danger btn-sm" onclick="eliminar('@p.ID_Parametro')"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="paramModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Gestión de Parámetro</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <label>ID</label>
                    <input type="text" name="IdParametro" class="form-control text-uppercase" maxlength="10" required />
                    <label>Valor</label>
                    <textarea name="Valor" class="form-control" maxlength="500" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#dataTable').DataTable();
    </script>
}