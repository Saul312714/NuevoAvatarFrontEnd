@page
@model NuevoAvatarFront.Pages.Profesores.EliminarModel
@{
    ViewData["Title"] = "Eliminar Profesor";
    Layout = "_Layout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-danger">
            <i class="fas fa-exclamation-triangle"></i> @ViewData["Title"]
        </h6>
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card-body">
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            Esta acción <strong>no se puede deshacer</strong>. Se eliminará definitivamente el profesor con ID
            <strong>@Model.id</strong>.
        </div>

        <form method="post" class="mt-3">
            <input type="hidden" name="id" value="@Model.id" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Eliminar
                </button>
                <a asp-page="./Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
