@page
@model NuevoAvatarFront.Pages.Modulos.DeleteModel
@{
    Layout = "_Layout";
}

<div class="card shadow">
    <div class="card-header">
        <h4>Desactivar Módulo</h4>
    </div>

    <div class="card-body">
        <p>¿Está seguro que desea desactivar este módulo?</p>

        <p class="text-muted">
            Este módulo no será eliminado de la base de datos, simplemente quedará inactivo y no aparecerá en el menú ni podrá ser asignado a roles.
        </p>

        <ul>
            <li><strong>Nombre:</strong> @Model.Modulo.Nombre</li>
            <li><strong>Url:</strong> @Model.Modulo.Url</li>
            <li><strong>Orden:</strong> @Model.Modulo.Orden</li>
        </ul>

        <form method="post">

            <!-- ID oculto -->
            <input type="hidden" asp-for="Modulo.ID_Modulo" />

            <!-- Campo oculto para cambiar Activo a false -->
            <input type="hidden" name="Modulo.Activo" value="false" />

            <button class="btn btn-danger">Desactivar</button>
            <a asp-page="/Modulos/Index" class="btn btn-secondary ml-2">Cancelar</a>

        </form>
    </div>
</div>
