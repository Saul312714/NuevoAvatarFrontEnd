@page "{id:int}"
@model NuevoAvatarFront.Pages.Usuarios.DetalleModel
@{
    ViewData["Title"] = "Detalle de Usuario";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Detalle de Usuario</h6>
    </div>
    <div class="card-body">
        @if (Model.Usuario != null)
        {
            <dl class="row">
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Usuario.Email</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Usuario.Nombre</dd>

                <dt class="col-sm-3">Identificación</dt>
                <dd class="col-sm-9">@Model.Usuario.Identificacion</dd>

                <dt class="col-sm-3">Rol</dt>
                <dd class="col-sm-9">@Model.Usuario.RolNombre</dd>
            </dl>

            <div class="text-end">
                <a href="/Usuarios/Index" class="btn btn-secondary">Volver</a>
                <a href="/Usuarios/Upsert?id=@Model.Usuario.ID_Usuario" class="btn btn-warning">Editar</a>
            </div>
        }
        else
        {
            <div class="alert alert-danger">Usuario no encontrado.</div>
        }
    </div>
</div>
