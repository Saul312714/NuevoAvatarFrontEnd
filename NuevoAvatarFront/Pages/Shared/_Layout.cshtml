@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration

@{
    // Obtener datos del usuario desde la sesión
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UsuarioID") ?? 0;
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "Usuario";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "Rol";
    var title = ViewData["Title"] ?? "Nuevo Avatar";

    // Obtener URL del API de bitácora desde appsettings.json
    var bitacoraApi = Configuration["BitacoraApi:BaseUrl"] ?? "http://localhost:5062/";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Nuevo Avatar</title>
    <link rel="icon" href="/images/logo.png" />

    <!-- Estilos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/css/sb-admin-2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>

<body id="page-top">
    <div id="wrapper">

        <!-- Sidebar -->
        <partial name="~/Pages/Shared/_Sidebar.cshtml" />

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Topbar -->
            <partial name="~/Pages/Shared/_Topbar.cshtml" />

            <!-- Main Content -->
            <div class="container-fluid mt-3">

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Dashboard/Index">Inicio</a></li>
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    </ol>
                </nav>

                <!-- Contenedor para alertas -->
                <div id="alertContainer"></div>

                <!-- Aquí se renderiza el contenido de cada página -->
                @RenderBody()
            </div>

            <!-- Footer -->
            <partial name="~/Pages/Shared/_Footer.cshtml" />
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/js/sb-admin-2.min.js"></script>

    <!--Función global de notificaciones -->
    <script>
        function showAlert(type, message) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 2500
            });
        }
    </script>

    <!-- Registro automático de errores de UI -->
    <script>
        window.addEventListener("error", function (e) {
            fetch("@bitacoraApi/bitacora", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    ID_Usuario: @userId,
                    Accion: "Error de UI: " + e.message
                })
            }).catch(err => console.error("No se pudo registrar el error en bitácora", err));
        });
    </script>

    <!-- Registro de acceso y navegación -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const bitacoraUrl = "@bitacoraApi/bitacora";
            const userId = @userId;

            // Registrar acceso inicial
            fetch(bitacoraUrl, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    ID_Usuario: userId,
                    Accion: "Acceso al sistema"
                })
            });

            // Registrar cambio de ruta
            document.querySelectorAll("a.nav-link").forEach(link => {
                link.addEventListener("click", () => {
                    fetch(bitacoraUrl, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            ID_Usuario: userId,
                            Accion: "Cambio de ruta: " + link.getAttribute("href")
                        })
                    });
                });
            });
        });
    </script>

    <!-- Refresh automático del token -->
    <script>
        async function tryRefreshToken() {
            const currentPath = window.location.pathname.toLowerCase();

            // Evitar ejecución en login
            if (currentPath.includes("/login")) return;

            const userId = @userId;
            const refreshToken = '@(HttpContextAccessor.HttpContext?.Session.GetString("RefreshToken") ?? "")';

            if (!userId || userId === 0 || !refreshToken || refreshToken.trim() === "") {
                console.warn("No hay sesión o refresh token, no se refresca.");
                return;
            }

            const refreshUrl = '@(Configuration["AuthApi:BaseUrl"] + "login/refresh")';

            try {
                const res = await fetch(refreshUrl, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ refreshToken })
                });

                if (res.ok) {
                    console.log("Token actualizado automáticamente:", new Date().toLocaleTimeString());
                } else if (res.status === 401) {
                    console.warn("Token expirado o inválido. Esperando próxima acción del usuario.");
                }
            } catch (error) {
                console.error("Error al refrescar token:", error);
            }
        }

        // Ejecutar el refresh solo después de unos segundos (evita colisión tras login)
        setTimeout(tryRefreshToken, 7000);

        // Y cada 5 minutos mientras navega
        setInterval(tryRefreshToken, 5 * 60 * 1000);
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
