@inject IHttpContextAccessor HttpContextAccessor

@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "Usuario";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "Rol";
}

<nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 shadow d-flex justify-content-between">

    <!-- Izquierda -->
    <div class="d-flex align-items-center">
        <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle">
            <i class="fa fa-bars"></i>
        </button>

        <span class="ms-3 fw-bold text-primary" style="font-size: 1.1rem;">
            Sistema Nuevo Avatar
        </span>
    </div>

    <!-- Derecha -->
    <ul class="navbar-nav align-items-center">

        <!-- Nombre del usuario -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center"
               href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">

                <span class="text-gray-600 small me-2">
                    @userName (@userRole)
                </span>

                <img class="img-profile rounded-circle"
                     src="/img/undraw_profile.svg"
                     style="width: 32px; height: 32px;">
            </a>

            <!-- Dropdown -->
            <ul class="dropdown-menu dropdown-menu-end shadow animated--grow-in">

                <li>
                    <a class="dropdown-item" href="~/Pages/Usuarios/Index">
                        <i class="fas fa-user fa-sm fa-fw me-2 text-gray-400"></i>
                        Perfil
                    </a>
                </li>

                <li><hr class="dropdown-divider" /></li>

                <li>
                    <a class="dropdown-item text-danger" href="/HU_MICHEL/Login?logout=1">

                        <i class="fas fa-sign-out-alt fa-sm fa-fw me-2 text-gray-400"></i>
                        Cerrar sesión
                    </a>
                </li>

            </ul>
        </li>
    </ul>

</nav>
