@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration

@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UsuarioID") ?? 0;
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "Usuario";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "Rol";
    var title = ViewData["Title"] ?? "Nuevo Avatar";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Nuevo Avatar</title>

    <!-- SB Admin 2 -->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet" />
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet" />
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" />
</head>

<body id="page-top">

    <div id="wrapper">

        <!-- SIDEBAR -->
        <partial name="~/Pages/Shared/_Sidebar.cshtml" />

        <!-- CONTENT WRAPPER -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- MAIN CONTENT -->
            <div id="content">

                <!-- TOPBAR -->
                <partial name="~/Pages/Shared/_Topbar.cshtml" />

                <!-- PAGE CONTENT -->
                <div class="container-fluid">

                    <!-- BREADCRUMB -->
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Dashboard/Index">Inicio</a></li>
                            <li class="breadcrumb-item active">@ViewData["Title"]</li>
                        </ol>
                    </nav>

                    <!-- PAGE BODY -->
                    @RenderBody()

                </div>

            </div>

            <!-- FOOTER -->
            <partial name="~/Pages/Shared/_Footer.cshtml" />

        </div>
    </div>

    <!-- Scripts base -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.1/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/vendor/chart.js/Chart.min.js"></script>
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/sb-admin-2.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Mostrar alertas enviadas por TempData -->
    @if (TempData["Success"] != null)
    {
        <script> sessionStorage.setItem("SuccessMessage", "@TempData["Success"]"); </script>
    }

    @if (TempData["Error"] != null)
    {
        <script> sessionStorage.setItem("ErrorMessage", "@TempData["Error"]"); </script>
    }

    <script>
        const params = new URLSearchParams(window.location.search);

        if (params.get("expired") === "1") {
            Swal.fire({
                icon: "warning",
                title: "Sesión expirada",
                text: "Debe iniciar sesión nuevamente.",
                timer: 2000,
                showConfirmButton: false
            });
            sessionStorage.clear();
            localStorage.clear();
        }

        if (params.get("logout") === "1") {
            Swal.fire({
                icon: "success",
                title: "Sesión cerrada",
                text: "Has salido del sistema correctamente.",
                timer: 2000,
                showConfirmButton: false
            });
            sessionStorage.clear();
            localStorage.clear();
        }

        // Mensajes globales desde TempData → SweetAlert2
        document.addEventListener("DOMContentLoaded", () => {
            const success = sessionStorage.getItem("SuccessMessage");
            const error = sessionStorage.getItem("ErrorMessage");

            if (success) {
                Swal.fire({
                    icon: "success",
                    title: "Éxito",
                    text: success,
                    timer: 2000,
                    showConfirmButton: false
                });
                sessionStorage.removeItem("SuccessMessage");
            }

            if (error) {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: error,
                });
                sessionStorage.removeItem("ErrorMessage");
            }
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
