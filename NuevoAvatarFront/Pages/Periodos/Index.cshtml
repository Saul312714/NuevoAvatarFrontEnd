@page
@model NuevoAvatarFront.Pages.Periodos.IndexModel
@{
    ViewData["Title"] = "Periodos";
    Layout = "_Layout";
}

@if (TempData["ok"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["err"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}
@if (TempData["error"] is string err2)
{
    <div class="alert alert-danger">@err2</div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Periodos</h6>
        <div>
            <a asp-page="./Upsert" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Nuevo
            </a>
        </div>
    </div>

    <div class="card-body">
        <form id="filtrosForm" method="get" class="row g-2 mb-3">
            <div class="col-md-5">
                <input name="q" value="@Model.q" class="form-control"
                       placeholder="Buscar por año, número o fecha..." />
            </div>

            <div class="col-md-3">
                <select asp-for="sort" asp-items="Model.SortOptions" class="form-select"></select>
            </div>

            <div class="col-md-2">
                <select asp-for="size" asp-items="Model.SizeOptions" class="form-select"></select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="table-dark text-white">
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Año</th>
                        <th>Número</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Estado</th>
                        <th style="width:190px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Periodos)
                    {
                        var estado = Model.EstadoDe(p);
                        <tr>
                            <td>@p.ID_Periodo</td>
                            <td>@p.Anno</td>
                            <td>@p.Numero</td>
                            <td>@p.Fecha_Inicio.ToString("yyyy-MM-dd")</td>
                            <td>@p.Fecha_Fin.ToString("yyyy-MM-dd")</td>
                            <td><span class="@Model.EstadoClase(estado)">@estado</span></td>
                            <td class="text-end">
                                <a asp-page="./Upsert" asp-route-id="@p.ID_Periodo" class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-edit"></i> Modificar
                                </a>

                                <!-- Botón Eliminar: sólo data-id, sin onclick -->
                                <button type="button"
                                        class="btn btn-danger btn-sm btn-eliminar-periodo"
                                        data-id="@p.ID_Periodo">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Form oculto para enviar el POST a Periodos/Eliminar -->
        <form id="formEliminarPeriodo" method="post" asp-page="./Eliminar">
            <input type="hidden" name="id" id="periodoIdEliminar" />
        </form>

        @{
            var pages = (int)Math.Ceiling((double)Model.Total / Math.Max(Model.size, 1));
            if (pages < 1) { pages = 1; }
        }
        <nav aria-label="Paginación" class="mt-3">
            <ul class="pagination mb-0">
                @for (int i = 1; i <= pages; i++)
                {
                    <li class="page-item @(i == Model.page ? "active" : "")">
                        <a class="page-link" href="?q=@Model.q&sort=@Model.sort&page=@i&size=@Model.size">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <!-- Igual que en Profesores -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function confirmarEliminarPeriodo(id) {
            Swal.fire({
                title: '¿Eliminar período?',
                text: `Esta acción no se puede deshacer. Se eliminará definitivamente el período con ID ${id}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#e3342f',
                cancelButtonColor: '#3085d6'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('periodoIdEliminar').value = id;
                    document.getElementById('formEliminarPeriodo').submit();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // enganchar los botones de eliminar
            document.querySelectorAll('.btn-eliminar-periodo').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    confirmarEliminarPeriodo(id);
                });
            });

            // filtros (igual que antes)
            const form = document.getElementById('filtrosForm');
            const sort = form.querySelector('[name="sort"]');
            const size = form.querySelector('[name="size"]');
            const q = form.querySelector('[name="q"]');

            sort.addEventListener('change', () => form.submit());
            size.addEventListener('change', () => form.submit());
            q.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); form.submit(); }
            });

            // DataTables sin paginación propia
            if (window.$ && $.fn.DataTable) {
                $('#dataTable').DataTable({
                    paging: false,
                    searching: false,
                    info: false
                });
            }
        });
    </script>
}
