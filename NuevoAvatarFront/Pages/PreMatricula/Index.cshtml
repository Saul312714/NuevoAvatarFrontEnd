@page
@model NuevoAvatarFront.Pages.PreMatriculas.IndexModel
@{
    ViewData["Title"] = "Gestión de Prematrículas";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>
                <i class="bi bi-journal-check"></i> Gestión de Prematrículas
            </h2>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nueva Prematrícula
            </a>
        </div>
    </div>

    @* Mensajes de éxito o error *@
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Panel de filtros *@
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-funnel"></i> Filtros de Búsqueda
            </h5>
        </div>
        <div class="card-body">
            <form method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Periodo</label>
                        <input type="number" class="form-control" asp-for="FiltroPeriodo" placeholder="ID del periodo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Carrera</label>
                        <input type="number" class="form-control" asp-for="FiltroCarrera" placeholder="ID de la carrera" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Curso</label>
                        <input type="number" class="form-control" asp-for="FiltroCurso" placeholder="ID del curso" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Estudiante</label>
                        <input type="number" class="form-control" asp-for="FiltroEstudiante" placeholder="ID del estudiante" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Buscar
                        </button>

                        @* Botón para limpiar filtros: llama al handler OnGetLimpiarFiltrosAsync *@
                        <a asp-page="./Index"
                           asp-page-handler="LimpiarFiltros"
                           class="btn btn-secondary ms-2">
                            <i class="bi bi-x-circle"></i> Limpiar Filtros
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Tabla de prematrículas *@
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-table"></i> Listado de Prematrículas
                <span class="badge bg-secondary">@Model.PreMatriculas.Count registros</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.PreMatriculas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>ID Estudiante</th>
                                <th>ID Carrera</th>
                                <th>ID Curso</th>
                                <th>ID Periodo</th>
                                <th>Observaciones</th>
                                <th class="text-center" style="width: 180px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PreMatriculas)
                            {
                                <tr>
                                    <td>@item.ID_Prematricula</td>
                                    <td>@item.ID_Estudiante</td>
                                    <td>@item.ID_Carrera</td>
                                    <td>@item.ID_Curso</td>
                                    <td>@item.ID_Periodo</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Observaciones))
                                        {
                                            <span title="@item.Observaciones">
                                                @(item.Observaciones.Length > 50
                                                    ? item.Observaciones.Substring(0, 50) + "..."
                                                    : item.Observaciones)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin observaciones</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-page="Details" asp-route-id="@item.ID_Prematricula"
                                               class="btn btn-sm btn-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="Edit" asp-route-id="@item.ID_Prematricula"
                                               class="btn btn-sm btn-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @* ✅ Nuevo: usar página Delete en lugar de modal *@
                                            <a asp-page="Delete"
                                               asp-route-id="@item.ID_Prematricula"
                                               class="btn btn-sm btn-danger"
                                               title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0" role="alert">
                    <i class="bi bi-info-circle"></i>
                    No se encontraron prematrículas con los filtros aplicados.
                </div>
            }
        </div>
    </div>
</div>

@* Modal de confirmación para eliminar *@
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro que desea eliminar esta prematrícula? Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" asp-page-handler="Delete" id="formEliminar">
                    <input type="hidden" name="id" id="idEliminar" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminacion(id) {
            document.getElementById('idEliminar').value = id;
            const modal = new bootstrap.Modal(document.getElementById('modalEliminar'));
            modal.show();
        }

        // Auto-cerrar alertas después de 5 segundos
        setTimeout(function () {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}

